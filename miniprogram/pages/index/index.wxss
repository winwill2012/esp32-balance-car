.page {
  position: relative;
  min-height: 100vh;
  padding: 20rpx 28rpx 56rpx;
  overflow: hidden;
  background:
    radial-gradient(90% 60% at 0% 0%, rgba(5, 150, 105, 0.22), transparent 55%),
    radial-gradient(80% 50% at 100% 8%, rgba(15, 118, 110, 0.14), transparent 52%),
    linear-gradient(165deg, #8fa8b8 0%, #6f8f9c 45%, #5f7f8a 100%);
}

.card {
  background: #f4f7f2;
  border: 2rpx solid rgba(15, 40, 35, 0.12);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(20, 40, 50, 0.14);
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.actions.bottom {
  margin-top: 12rpx;
  margin-bottom: 0;
}

.actions--three {
  gap: 10rpx;
}

.btn {
  flex: 1;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 2.2;
  border: none;
}

.btn.btn--compact {
  min-width: 0;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 22rpx;
  letter-spacing: 0;
  border-radius: 14rpx;
}

.btn::after {
  border: none;
}

.btn.save {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #10b981 0%, #059669 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  box-shadow: 0 10rpx 24rpx rgba(5, 150, 105, 0.32);
}

.btn.save[disabled] {
  background: #94a3b8 !important;
  color: #e2e8f0 !important;
  border-color: transparent !important;
  box-shadow: none !important;
  opacity: 1 !important;
}

.btn.calib {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #065f46;
  background: #ffffff;
  border: 2rpx solid rgba(5, 150, 105, 0.45);
  box-shadow: 0 8rpx 18rpx rgba(20, 40, 50, 0.1);
}

.btn.calib[disabled] {
  color: #94a3b8 !important;
  background: rgba(255, 255, 255, 0.55) !important;
  border-color: rgba(148, 163, 184, 0.35) !important;
  box-shadow: none !important;
  opacity: 1 !important;
}

.cal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.55);
}

.cal-panel {
  width: 520rpx;
  padding: 48rpx 36rpx 40rpx;
  border-radius: 28rpx;
  text-align: center;
  background: linear-gradient(180deg, #ecfdf5 0%, #f8fafc 100%);
  border: 2rpx solid rgba(5, 150, 105, 0.25);
  box-shadow: 0 20rpx 48rpx rgba(15, 23, 42, 0.28);
}

.cal-count {
  display: block;
  font-size: 120rpx;
  font-weight: 800;
  line-height: 1;
  color: #047857;
  font-variant-numeric: tabular-nums;
}

.cal-tip {
  display: block;
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #123028;
}

.cal-phase {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}

.dz-board {
  display: flex;
  align-items: stretch;
  margin: 0 24rpx 20rpx;
  padding: 16rpx 8rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(5, 150, 105, 0.14);
}

.dz-item {
  flex: 1;
  text-align: center;
}

.dz-divider {
  width: 2rpx;
  background: rgba(15, 50, 40, 0.1);
}

.dz-label {
  display: block;
  font-size: 22rpx;
  color: #5b7368;
  margin-bottom: 4rpx;
}

.dz-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #065f46;
  font-variant-numeric: tabular-nums;
}

.meter-card {
  display: flex;
  align-items: stretch;
  padding: 20rpx 12rpx;
  background: linear-gradient(180deg, #eaf8f1 0%, #f5fbf8 100%);
  border-color: rgba(5, 150, 105, 0.2);
}

.meter-item {
  flex: 1;
  text-align: center;
}

.meter-divider {
  width: 2rpx;
  background: rgba(15, 50, 40, 0.12);
}

.meter-label {
  display: block;
  font-size: 22rpx;
  color: #4b635a;
  margin-bottom: 4rpx;
}

.meter-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: #123028;
  line-height: 1.2;
}

.meter-value.accent {
  color: #047857;
}

.tune-area.is-locked {
  opacity: 0.78;
}

.tune-area.is-locked .card {
  filter: saturate(0.75);
}

.loop-card {
  padding: 0;
  overflow: hidden;
  background: linear-gradient(180deg, #eaf8f1 0%, #f7faf8 100%);
  border: 2rpx solid rgba(5, 150, 105, 0.18);
  border-radius: 18rpx;
  box-shadow: 0 8rpx 20rpx rgba(20, 40, 50, 0.14);
}

.loop-outer {
  background: linear-gradient(180deg, #eef7f4 0%, #f7faf8 100%);
  border-color: rgba(15, 118, 110, 0.18);
}

.loop-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx 16rpx;
  border-bottom: 2rpx solid rgba(5, 150, 105, 0.1);
  background: rgba(255, 255, 255, 0.42);
}

.loop-outer .loop-head {
  border-bottom-color: rgba(15, 118, 110, 0.1);
}

.loop-badge {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffffff;
  background: #059669;
}

.loop-outer .loop-badge {
  background: #0f766e;
}

.loop-meta {
  flex: 1;
  min-width: 0;
}

.loop-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.loop-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #065f46;
  line-height: 1.2;
}

.loop-outer .loop-title {
  color: #115e59;
}

.loop-help {
  width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 18rpx;
  font-weight: 700;
  color: #047857;
  background: rgba(5, 150, 105, 0.12);
  border: 2rpx solid rgba(5, 150, 105, 0.45);
  border-radius: 999rpx;
}

.loop-outer .loop-help {
  color: #0f766e;
  background: rgba(15, 118, 110, 0.12);
  border-color: rgba(15, 118, 110, 0.45);
}

.loop-flow {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #5b7368;
}

.param-split {
  height: 2rpx;
  margin: 0 24rpx;
  background: rgba(5, 150, 105, 0.1);
}

.cascade-hint {
  display: flex;
  justify-content: center;
  margin: -2rpx 0 12rpx;
}

.cascade-arrow {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #ecfdf5;
  background: rgba(6, 78, 59, 0.42);
  letter-spacing: 1rpx;
}

.param-block {
  padding: 18rpx 24rpx 20rpx;
}

.param-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.param-title {
  flex-shrink: 0;
  width: 56rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #047857;
  line-height: 1.2;
}

.param-desc {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.3;
  text-align: center;
}

.param-tag {
  flex-shrink: 0;
  width: 120rpx;
  height: 48rpx;
  min-height: 48rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 48rpx;
  border-radius: 999rpx;
  border: none;
  color: #065f46;
  background: #d1fae5;
}

.param-slider {
  margin: 2rpx 0 6rpx;
}

.quick-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
}

.qbtn {
  flex: 1;
  margin: 0;
  padding: 0;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #047857;
  background: #ffffff;
  border: 2rpx solid rgba(5, 150, 105, 0.42);
  border-radius: 14rpx;
  box-shadow: 0 4rpx 10rpx rgba(20, 40, 50, 0.06);
}

.qbtn::after {
  border: none;
}

.qbtn[disabled] {
  color: #94a3b8 !important;
  background: rgba(255, 255, 255, 0.55) !important;
  border-color: rgba(148, 163, 184, 0.35) !important;
  box-shadow: none !important;
  opacity: 1 !important;
}
