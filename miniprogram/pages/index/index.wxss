.page {
  position: relative;
  min-height: 100vh;
  padding: 20rpx 28rpx 56rpx;
  overflow: hidden;
  background:
    radial-gradient(90% 60% at 0% 0%, rgba(5, 150, 105, 0.28), transparent 55%),
    radial-gradient(80% 50% at 100% 10%, rgba(29, 78, 216, 0.18), transparent 50%),
    linear-gradient(165deg, #8fa8b8 0%, #6f8f9c 45%, #5f7f8a 100%);
}

.card {
  background: #f7faf7;
  border: 2rpx solid rgba(15, 40, 35, 0.1);
  border-radius: 22rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 10rpx 24rpx rgba(20, 40, 50, 0.12);
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.actions.bottom {
  margin-top: 12rpx;
  margin-bottom: 0;
}

.btn {
  flex: 1;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 2.2;
  border: none;
}

.btn::after {
  border: none;
}

.btn.save {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #34d399 0%, #10b981 38%, #059669 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  box-shadow:
    0 12rpx 28rpx rgba(5, 150, 105, 0.38),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.28);
}

.btn.save[disabled] {
  background: linear-gradient(180deg, #a7b8b1 0%, #8aa39a 100%) !important;
  color: #e8eeeb !important;
  border-color: transparent !important;
  box-shadow: none !important;
  opacity: 1 !important;
}

.meter-card {
  display: flex;
  align-items: stretch;
  padding: 20rpx 12rpx;
  background: #e8f2ec;
  border-color: rgba(4, 120, 87, 0.22);
}

.meter-item {
  flex: 1;
  text-align: center;
}

.meter-divider {
  width: 2rpx;
  background: rgba(15, 50, 40, 0.14);
}

.meter-label {
  display: block;
  font-size: 22rpx;
  color: #4b635a;
  margin-bottom: 4rpx;
}

.meter-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: #123028;
  line-height: 1.2;
}

.meter-value.accent {
  color: #c2410c;
}

.section-label {
  margin: 8rpx 0 12rpx;
  font-size: 22rpx;
  color: #e8f2f0;
  letter-spacing: 2rpx;
  font-weight: 600;
  text-shadow: 0 1rpx 2rpx rgba(20, 40, 50, 0.25);
}

.tune-area.is-locked {
  opacity: 0.78;
}

.tune-area.is-locked .card {
  filter: saturate(0.7);
}

.loop-card {
  padding: 0;
  overflow: hidden;
  border: 2rpx solid rgba(15, 40, 35, 0.08);
  border-radius: 22rpx;
  box-shadow: 0 10rpx 26rpx rgba(20, 40, 50, 0.12);
}

.loop-inner {
  border-color: rgba(5, 150, 105, 0.2);
  background: linear-gradient(180deg, #eaf8f1 0%, #f5fbf8 40%, #fcfefd 100%);
}

.loop-outer {
  border-color: rgba(234, 88, 12, 0.2);
  background: linear-gradient(180deg, #fff1e6 0%, #faf6f2 40%, #fffcfa 100%);
}

.loop-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx 18rpx;
  border-bottom: 2rpx solid transparent;
}

.loop-inner .loop-head {
  background: linear-gradient(105deg, #bbf7d0 0%, #d1fae5 35%, #ecfdf5 78%, #f0fdf9 100%);
  border-bottom-color: rgba(5, 150, 105, 0.12);
}

.loop-outer .loop-head {
  background: linear-gradient(105deg, #fed7aa 0%, #ffedd5 35%, #fff7ed 78%, #fffaf5 100%);
  border-bottom-color: rgba(234, 88, 12, 0.12);
}

.loop-badge {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffffff;
  background: #059669;
}

.loop-outer .loop-badge {
  background: #ea580c;
  color: #ffffff;
}

.loop-meta {
  flex: 1;
  min-width: 0;
}

.loop-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #134e3a;
  line-height: 1.2;
}

.loop-outer .loop-title {
  color: #9a3412;
}

.loop-flow {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #3f6b5a;
}

.loop-outer .loop-flow {
  color: #9a6a4a;
}

.loop-inner .param-split {
  background: rgba(5, 150, 105, 0.12);
}

.loop-outer .param-split {
  background: rgba(234, 88, 12, 0.12);
}

.loop-inner .param-title {
  color: #047857;
}

.loop-outer .param-title,
.loop-outer .accent-kv .param-title {
  color: #c2410c;
}

.loop-inner .param-desc,
.loop-outer .param-desc {
  color: #64748b;
}

.cascade-hint {
  display: flex;
  justify-content: center;
  margin: -4rpx 0 10rpx;
}

.cascade-arrow {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #e8f2f0;
  background: rgba(15, 40, 35, 0.22);
  letter-spacing: 1rpx;
}

.param-block {
  padding: 18rpx 24rpx 20rpx;
}

.param-split {
  height: 2rpx;
  margin: 0 24rpx;
  background: rgba(15, 40, 35, 0.08);
}

.param-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.param-title {
  flex-shrink: 0;
  width: 56rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #123028;
  line-height: 1.2;
}

.accent-kd .param-title {
  color: #1e3a8a;
}

.accent-kv .param-title {
  color: #9a3412;
}

.param-desc {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.3;
  text-align: center;
}

.param-tag {
  flex-shrink: 0;
  width: 120rpx;
  height: 48rpx;
  min-height: 48rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 48rpx;
  border-radius: 999rpx;
  border: none;
  color: #065f46;
  background: #d1fae5;
}

.accent-kd .param-tag {
  color: #1e40af;
  background: #dbeafe;
}

.accent-kv .param-tag {
  color: #9a3412;
  background: #ffedd5;
}

.param-slider {
  margin: 2rpx 0 6rpx;
}

.quick-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
}

.qbtn {
  flex: 1;
  margin: 0;
  padding: 0;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  background: #ffffff;
  border: 2rpx solid rgba(15, 40, 35, 0.12);
  border-radius: 14rpx;
  box-shadow: 0 4rpx 10rpx rgba(20, 40, 50, 0.06);
}

.accent-kp .qbtn {
  color: #047857;
  background: #ffffff;
  border-color: rgba(5, 150, 105, 0.42);
}

.accent-kd .qbtn {
  color: #1d4ed8;
  background: #ffffff;
  border-color: rgba(37, 99, 235, 0.42);
}

.accent-kv .qbtn {
  color: #c2410c;
  background: #ffffff;
  border-color: rgba(234, 88, 12, 0.42);
}

.qbtn::after {
  border: none;
}

.qbtn[disabled] {
  color: #94a3b8 !important;
  background: rgba(255, 255, 255, 0.55) !important;
  border-color: rgba(148, 163, 184, 0.35) !important;
  box-shadow: none !important;
  opacity: 1 !important;
}
