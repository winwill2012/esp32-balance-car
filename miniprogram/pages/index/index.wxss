.page {
  min-height: 100vh;
  padding: 20rpx 28rpx 56rpx;
  background: #f5f7fa;
}

.card {
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx;
  background: #ffffff;
  border: 2rpx solid #dfe5ec;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.035);
}

.actions {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.actions.bottom {
  margin-top: 12rpx;
  margin-bottom: 0;
}

.btn {
  flex: 1;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 10rpx;
  font-size: 28rpx;
  line-height: 2.2;
}

.btn::after {
  border: none;
}

.btn.btn--compact {
  min-width: 0;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 22rpx;
  letter-spacing: 0;
  border-radius: 10rpx;
}

.btn.save {
  color: #ffffff;
  font-weight: 700;
  background: #1677ff;
  border: 2rpx solid #1677ff;
  box-shadow: none;
}

.btn.calib {
  color: #111827;
  font-weight: 700;
  background: #ffffff;
  border: 2rpx solid #cbd5e1;
  box-shadow: none;
}

.btn.save[disabled],
.btn.calib[disabled] {
  color: #64748b !important;
  background: #f1f5f9 !important;
  border-color: #d7dee8 !important;
  box-shadow: none !important;
  opacity: 1 !important;
}

.cal-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.5);
}

.cal-panel {
  width: 520rpx;
  padding: 48rpx 36rpx 40rpx;
  text-align: center;
  background: #ffffff;
  border: 2rpx solid #dfe5ec;
  border-radius: 20rpx;
  box-shadow: 0 20rpx 48rpx rgba(15, 23, 42, 0.2);
}

.cal-count {
  display: block;
  color: #0d3b82;
  font-size: 120rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.cal-tip {
  display: block;
  margin-top: 24rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.cal-phase {
  display: block;
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
}

.meter-card {
  display: block;
  padding: 0;
  overflow: hidden;
}

.meter-row {
  display: flex;
  align-items: stretch;
  padding: 24rpx 12rpx;
}

.meter-item {
  flex: 1;
  text-align: center;
}

.meter-divider {
  width: 2rpx;
  background: #e2e8f0;
}

.meter-label {
  display: block;
  color: #111827;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.meter-value {
  display: block;
  color: #111827;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  font-size: 34rpx;
  line-height: 1.2;
}

.meter-value.accent {
  color: #0d3b82;
}

.tune-area.is-locked {
  opacity: 1;
}

.loop-card {
  padding: 0;
  overflow: hidden;
  background: #ffffff;
  border: 2rpx solid #dfe5ec;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.035);
}

.loop-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx 16rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #e5eaf0;
}

.loop-badge {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  color: #0d3b82;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  background: #e7f0ff;
  border-radius: 8rpx;
}

.loop-meta {
  flex: 1;
  min-width: 0;
}

.loop-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.loop-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.loop-help,
.setting-help {
  width: 30rpx;
  height: 30rpx;
  color: #0d3b82;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  background: #ffffff;
  border: 2rpx solid #9fb2cb;
  border-radius: 50%;
}

.loop-flow {
  display: block;
  margin-top: 4rpx;
  color: #475569;
  font-size: 20rpx;
}

.param-block {
  padding: 18rpx 24rpx 20rpx;
}

.param-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.param-title {
  flex-shrink: 0;
  width: 56rpx;
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.param-desc {
  flex: 1;
  min-width: 0;
  color: #1f2937;
  font-size: 22rpx;
  line-height: 1.3;
  text-align: center;
}

.param-tag {
  flex-shrink: 0;
  width: 120rpx;
  height: 48rpx;
  min-height: 48rpx;
  padding: 0 12rpx;
  color: #0d3b82;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
  background: #f1f4f8;
  border: 2rpx solid #e2e8f0;
  border-radius: 8rpx;
}

.param-slider {
  margin: 2rpx 0 6rpx;
}

.quick-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
}

.qbtn {
  flex: 1;
  height: 64rpx;
  margin: 0;
  padding: 0;
  color: #111827;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 64rpx;
  background: #ffffff;
  border: 2rpx solid #d7dee8;
  border-radius: 8rpx;
  box-shadow: none;
}

.qbtn::after {
  border: none;
}

.qbtn[disabled] {
  color: #111827 !important;
  background: #fafbfc !important;
  border-color: #e2e8f0 !important;
  box-shadow: none !important;
  opacity: 1 !important;
}

.param-split {
  height: 2rpx;
  margin: 0 24rpx;
  background: #e8edf2;
}

.cascade-hint {
  display: flex;
  justify-content: center;
  margin: -2rpx 0 12rpx;
}

.cascade-arrow {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  color: #334155;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  background: #f1f4f8;
  border: 2rpx solid #e2e8f0;
  border-radius: 999rpx;
}

.cascade-info {
  width: 28rpx;
  height: 28rpx;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
  background: #0d3b82;
  border-radius: 50%;
}

.outer-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
  padding: 6rpx;
  background: #e9eef5;
  border-radius: 12rpx;
}

.outer-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  border-radius: 9rpx;
}

.outer-tab.is-active {
  color: #0d3b82;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.08);
}
