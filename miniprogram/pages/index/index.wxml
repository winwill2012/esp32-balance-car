<view class="page">
  <view class="page-body">
    <ble-status />

    <view class="card meter-card">
      <view class="meter-row">
        <view class="meter-item">
          <text class="meter-label">当前倾角</text>
          <text class="meter-value">{{angleText}}</text>
        </view>
        <view class="meter-divider"></view>
        <view class="meter-item">
          <text class="meter-label">当前电量</text>
          <text class="meter-value accent">{{batteryText}}</text>
        </view>
        <view class="meter-divider"></view>
        <view class="meter-item">
          <text class="meter-label">输出 PWM</text>
          <text class="meter-value">{{pwmText}}</text>
        </view>
      </view>
    </view>

    <view class="tune-area {{connected ? 'is-live' : 'is-locked'}}">
      <view class="card loop-card loop-inner">
        <view class="loop-head">
          <view class="loop-badge">安装</view>
          <view class="loop-meta">
            <view class="loop-title-row">
              <text class="loop-title">机械零点</text>
              <view
                class="loop-help"
                catchtap="onTuneHelp"
                data-tip="手扶车找到最稳姿态，把当前倾角填到这里。\n范围 ±5°；未持久化时断连失效。"
              >?</view>
            </view>
            <text class="loop-flow">站稳时的传感器倾角偏置</text>
          </view>
        </view>

        <view class="param-block">
          <view class="param-top">
            <text class="param-title">A0</text>
            <text class="param-desc">平衡倾角 · −5–5°</text>
            <input
              class="param-tag"
              type="text"
              value="{{a0}}"
              bindinput="onA0Input"
              disabled="{{!connected}}"
            />
          </view>
          <slider
            class="param-slider"
            min="-5"
            max="5"
            step="0.1"
            value="{{a0}}"
            activeColor="{{connected ? '#0d3b82' : '#9ca3af'}}"
            backgroundColor="#d7dee8"
            block-size="22"
            disabled="{{!connected}}"
            bindchanging="onA0Changing"
            bindchange="onA0Change"
          />
          <view class="quick-row">
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="a0" data-delta="-0.5" bindtap="onNudge">−0.5</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="a0" data-delta="-0.1" bindtap="onNudge">−0.1</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="a0" bindtap="onResetParam">默认</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="a0" data-delta="0.1" bindtap="onNudge">+0.1</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="a0" data-delta="0.5" bindtap="onNudge">+0.5</button>
          </view>
        </view>

      </view>

      <view class="card loop-card loop-inner">
        <view class="loop-head">
          <view class="loop-badge">内环</view>
          <view class="loop-meta">
            <view class="loop-title-row">
              <text class="loop-title">直立环</text>
              <view
                class="loop-help"
                catchtap="onTuneHelp"
                data-tip="建议先将速度环和转向环关闭（参数置 0），依次调整 Kp、Kd，最后按需加入很小的 Ki。Ki=0 表示关闭积分；积分过大可能导致缓慢大幅摆动。"
              >?</view>
            </view>
            <text class="loop-flow">目标倾角 → PWM</text>
          </view>
        </view>

        <view class="param-block">
          <view class="param-top">
            <text class="param-title">Kp</text>
            <text class="param-desc">比例增益 · 0–300</text>
            <input
              class="param-tag"
              type="digit"
              value="{{kp}}"
              bindinput="onKpInput"
              disabled="{{!connected}}"
            />
          </view>
          <slider
            class="param-slider"
            min="0"
            max="300"
            step="1"
            value="{{kp}}"
            activeColor="{{connected ? '#0d3b82' : '#9ca3af'}}"
            backgroundColor="#d7dee8"
            block-size="22"
            disabled="{{!connected}}"
            bindchanging="onKpChanging"
            bindchange="onKpChange"
          />
          <view class="quick-row">
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kp" data-delta="-20" bindtap="onNudge">−20</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kp" data-delta="-5" bindtap="onNudge">−5</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kp" bindtap="onResetParam">默认</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kp" data-delta="5" bindtap="onNudge">+5</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kp" data-delta="20" bindtap="onNudge">+20</button>
          </view>
        </view>

        <view class="param-split"></view>

        <view class="param-block">
          <view class="param-top">
            <text class="param-title">Ki</text>
            <text class="param-desc">积分增益 · 0–5</text>
            <input class="param-tag" type="digit" value="{{ki}}" data-param="ki" bindinput="onParamInput" disabled="{{!connected}}" />
          </view>
          <slider class="param-slider" min="0" max="5" step="0.001" value="{{ki}}" data-param="ki" activeColor="{{connected ? '#0d3b82' : '#9ca3af'}}" backgroundColor="#d7dee8" block-size="22" disabled="{{!connected}}" bindchanging="onParamChanging" bindchange="onParamChange" />
          <view class="quick-row">
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="ki" data-delta="-0.1" bindtap="onNudge">−0.1</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="ki" data-delta="-0.01" bindtap="onNudge">−0.01</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="ki" bindtap="onResetParam">默认</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="ki" data-delta="0.01" bindtap="onNudge">+0.01</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="ki" data-delta="0.1" bindtap="onNudge">+0.1</button>
          </view>
        </view>

        <view class="param-split"></view>

        <view class="param-block">
          <view class="param-top">
            <text class="param-title">Kd</text>
            <text class="param-desc">微分增益 · 0–20</text>
            <input
              class="param-tag"
              type="digit"
              value="{{kd}}"
              bindinput="onKdInput"
              disabled="{{!connected}}"
            />
          </view>
          <slider
            class="param-slider"
            min="0"
            max="20"
            step="0.01"
            value="{{kd}}"
            activeColor="{{connected ? '#0d3b82' : '#9ca3af'}}"
            backgroundColor="#d7dee8"
            block-size="22"
            disabled="{{!connected}}"
            bindchanging="onKdChanging"
            bindchange="onKdChange"
          />
          <view class="quick-row">
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kd" data-delta="-0.5" bindtap="onNudge">−0.5</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kd" data-delta="-0.05" bindtap="onNudge">−0.05</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kd" bindtap="onResetParam">默认</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kd" data-delta="0.05" bindtap="onNudge">+0.05</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kd" data-delta="0.5" bindtap="onNudge">+0.5</button>
          </view>
        </view>
      </view>

      <view class="cascade-hint">
        <view class="cascade-arrow">
          <text class="cascade-info">i</text>
          <text>外环输出作为内环目标</text>
        </view>
      </view>

      <view class="outer-tabs">
        <view class="outer-tab {{outerLoopTab === 'speed' ? 'is-active' : ''}}" data-tab="speed" bindtap="onOuterLoopTab">速度环</view>
        <view class="outer-tab {{outerLoopTab === 'turn' ? 'is-active' : ''}}" data-tab="turn" bindtap="onOuterLoopTab">转向环</view>
      </view>

      <view class="card loop-card" wx:if="{{outerLoopTab === 'speed'}}">
        <view class="loop-head">
          <view class="loop-badge">外环</view>
          <view class="loop-meta">
            <view class="loop-title-row">
              <text class="loop-title">速度环</text>
              <view
                class="loop-help"
                catchtap="onTuneHelp"
                data-tip="速度误差转换为目标倾角。建议先只调整 Kp；Ki 用于消除稳态速度误差，Kd 对编码器噪声敏感。任一增益设为 0 即关闭对应项。"
              >?</view>
            </view>
            <text class="loop-flow">速度误差 → 目标倾角</text>
          </view>
        </view>

        <view class="param-block">
          <view class="param-top">
            <text class="param-title">Kp</text>
            <text class="param-desc">比例增益 · 0–5</text>
            <input class="param-tag" type="digit" value="{{skp}}" data-param="skp" bindinput="onParamInput" disabled="{{!connected}}" />
          </view>
          <slider class="param-slider" min="0" max="5" step="0.01" value="{{skp}}" data-param="skp" activeColor="{{connected ? '#0d3b82' : '#9ca3af'}}" backgroundColor="#d7dee8" block-size="22" disabled="{{!connected}}" bindchanging="onParamChanging" bindchange="onParamChange" />
          <view class="quick-row">
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="skp" data-delta="-0.1" bindtap="onNudge">−0.1</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="skp" data-delta="-0.01" bindtap="onNudge">−0.01</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="skp" bindtap="onResetParam">默认</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="skp" data-delta="0.01" bindtap="onNudge">+0.01</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="skp" data-delta="0.1" bindtap="onNudge">+0.1</button>
          </view>
        </view>

        <view class="param-split"></view>
        <view class="param-block">
          <view class="param-top">
            <text class="param-title">Ki</text>
            <text class="param-desc">积分增益 · 0–5</text>
            <input class="param-tag" type="digit" value="{{ski}}" data-param="ski" bindinput="onParamInput" disabled="{{!connected}}" />
          </view>
          <slider class="param-slider" min="0" max="5" step="0.001" value="{{ski}}" data-param="ski" activeColor="{{connected ? '#0d3b82' : '#9ca3af'}}" backgroundColor="#d7dee8" block-size="22" disabled="{{!connected}}" bindchanging="onParamChanging" bindchange="onParamChange" />
          <view class="quick-row">
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="ski" data-delta="-0.1" bindtap="onNudge">−0.1</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="ski" data-delta="-0.01" bindtap="onNudge">−0.01</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="ski" bindtap="onResetParam">默认</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="ski" data-delta="0.01" bindtap="onNudge">+0.01</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="ski" data-delta="0.1" bindtap="onNudge">+0.1</button>
          </view>
        </view>

        <view class="param-split"></view>
        <view class="param-block">
          <view class="param-top">
            <text class="param-title">Kd</text>
            <text class="param-desc">微分增益 · 0–10</text>
            <input class="param-tag" type="digit" value="{{skd}}" data-param="skd" bindinput="onParamInput" disabled="{{!connected}}" />
          </view>
          <slider class="param-slider" min="0" max="10" step="0.001" value="{{skd}}" data-param="skd" activeColor="{{connected ? '#0d3b82' : '#9ca3af'}}" backgroundColor="#d7dee8" block-size="22" disabled="{{!connected}}" bindchanging="onParamChanging" bindchange="onParamChange" />
          <view class="quick-row">
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="skd" data-delta="-0.1" bindtap="onNudge">−0.1</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="skd" data-delta="-0.01" bindtap="onNudge">−0.01</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="skd" bindtap="onResetParam">默认</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="skd" data-delta="0.01" bindtap="onNudge">+0.01</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="skd" data-delta="0.1" bindtap="onNudge">+0.1</button>
          </view>
        </view>
      </view>

      <view class="card loop-card" wx:elif="{{outerLoopTab === 'turn'}}">
        <view class="loop-head">
          <view class="loop-badge">外环</view>
          <view class="loop-meta">
            <view class="loop-title-row">
              <text class="loop-title">转向环</text>
              <view class="loop-help" catchtap="onTuneHelp" data-tip="目标偏航角速度与陀螺仪 Z 轴角速度构成闭环。先只使用 Kp；Ki 可消除持续慢转，Kd 可抑制快速变化但对噪声敏感。">?</view>
            </view>
            <text class="loop-flow">偏航角速度误差 → 差动 PWM</text>
          </view>
        </view>

        <view class="param-block">
          <view class="param-top"><text class="param-title">Kp</text><text class="param-desc">比例增益 · 0–10</text><input class="param-tag" type="digit" value="{{tkp}}" data-param="tkp" bindinput="onParamInput" disabled="{{!connected}}" /></view>
          <slider class="param-slider" min="0" max="10" step="0.01" value="{{tkp}}" data-param="tkp" activeColor="{{connected ? '#0d3b82' : '#9ca3af'}}" backgroundColor="#d7dee8" block-size="22" disabled="{{!connected}}" bindchanging="onParamChanging" bindchange="onParamChange" />
          <view class="quick-row"><button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="tkp" data-delta="-0.5" bindtap="onNudge">−0.5</button><button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="tkp" data-delta="-0.05" bindtap="onNudge">−0.05</button><button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="tkp" bindtap="onResetParam">默认</button><button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="tkp" data-delta="0.05" bindtap="onNudge">+0.05</button><button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="tkp" data-delta="0.5" bindtap="onNudge">+0.5</button></view>
        </view>
        <view class="param-split"></view>
        <view class="param-block">
          <view class="param-top"><text class="param-title">Ki</text><text class="param-desc">积分增益 · 0–5</text><input class="param-tag" type="digit" value="{{tki}}" data-param="tki" bindinput="onParamInput" disabled="{{!connected}}" /></view>
          <slider class="param-slider" min="0" max="5" step="0.001" value="{{tki}}" data-param="tki" activeColor="{{connected ? '#0d3b82' : '#9ca3af'}}" backgroundColor="#d7dee8" block-size="22" disabled="{{!connected}}" bindchanging="onParamChanging" bindchange="onParamChange" />
          <view class="quick-row"><button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="tki" data-delta="-0.1" bindtap="onNudge">−0.1</button><button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="tki" data-delta="-0.01" bindtap="onNudge">−0.01</button><button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="tki" bindtap="onResetParam">默认</button><button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="tki" data-delta="0.01" bindtap="onNudge">+0.01</button><button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="tki" data-delta="0.1" bindtap="onNudge">+0.1</button></view>
        </view>
        <view class="param-split"></view>
        <view class="param-block">
          <view class="param-top"><text class="param-title">Kd</text><text class="param-desc">微分增益 · 0–10</text><input class="param-tag" type="digit" value="{{tkd}}" data-param="tkd" bindinput="onParamInput" disabled="{{!connected}}" /></view>
          <slider class="param-slider" min="0" max="10" step="0.001" value="{{tkd}}" data-param="tkd" activeColor="{{connected ? '#0d3b82' : '#9ca3af'}}" backgroundColor="#d7dee8" block-size="22" disabled="{{!connected}}" bindchanging="onParamChanging" bindchange="onParamChange" />
          <view class="quick-row"><button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="tkd" data-delta="-0.1" bindtap="onNudge">−0.1</button><button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="tkd" data-delta="-0.01" bindtap="onNudge">−0.01</button><button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="tkd" bindtap="onResetParam">默认</button><button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="tkd" data-delta="0.01" bindtap="onNudge">+0.01</button><button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="tkd" data-delta="0.1" bindtap="onNudge">+0.1</button></view>
        </view>
      </view>

      <view class="actions bottom">
        <button class="btn save btn--compact" hover-class="none" disabled="{{!connected || calibrating}}" bindtap="onSave">持久化到芯片</button>
        <button class="btn calib btn--compact" hover-class="none" disabled="{{!connected || calibrating}}" bindtap="onGyroCalib">陀螺仪校准</button>
      </view>
    </view>
  </view>

  <view class="cal-mask" wx:if="{{calibrating}}">
    <view class="cal-panel">
      <text class="cal-count" wx:if="{{calCount > 0}}">{{calCount}}</text>
      <text class="cal-tip">{{calTip}}</text>
      <text class="cal-phase" wx:if="{{calPhase === 'prepare'}}">准备中</text>
      <text class="cal-phase" wx:elif="{{calPhase === 'running'}}">进行中</text>
      <text class="cal-phase" wx:else>完成</text>
    </view>
  </view>
</view>
