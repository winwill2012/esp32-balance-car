<view class="page">
  <view class="page-grid">
    <view class="page-grid__sharp"></view>
    <view class="page-grid__soft"></view>
  </view>

  <view class="page-body">
    <ble-status />

    <view class="card meter-card">
      <view class="meter-item">
        <text class="meter-label">倾角 °</text>
        <text class="meter-value">{{angleText}}</text>
      </view>
      <view class="meter-divider"></view>
      <view class="meter-item">
        <text class="meter-label">电池电量 %</text>
        <text class="meter-value accent">{{batteryText}}</text>
      </view>
      <view class="meter-divider"></view>
      <view class="meter-item">
        <text class="meter-label">PWM</text>
        <text class="meter-value">{{pwmText}}</text>
      </view>
    </view>

    <view class="tune-area {{connected ? 'is-live' : 'is-locked'}}">
      <view class="card loop-card loop-inner">
        <view class="loop-head">
          <view class="loop-badge">内环</view>
          <view class="loop-meta">
            <text class="loop-title">倾角 PD</text>
            <text class="loop-flow">目标倾角 → PWM</text>
          </view>
        </view>

        <view class="param-block accent-kp">
          <view class="param-top">
            <text class="param-title">Kp</text>
            <text class="param-desc">比例增益 · 0–200</text>
            <input
              class="param-tag"
              type="digit"
              value="{{kp}}"
              bindinput="onKpInput"
              disabled="{{!connected}}"
            />
          </view>
          <slider
            class="param-slider"
            min="0"
            max="200"
            step="0.5"
            value="{{kp}}"
            activeColor="{{connected ? '#059669' : '#9ca3af'}}"
            backgroundColor="#d5dde6"
            block-size="22"
            disabled="{{!connected}}"
            bindchanging="onKpChanging"
            bindchange="onKpChange"
          />
          <view class="quick-row">
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kp" data-delta="-5" bindtap="onNudge">−5</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kp" data-delta="-1" bindtap="onNudge">−1</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kp" data-delta="1" bindtap="onNudge">+1</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kp" data-delta="5" bindtap="onNudge">+5</button>
          </view>
        </view>

        <view class="param-split"></view>

        <view class="param-block accent-kd">
          <view class="param-top">
            <text class="param-title">Kd</text>
            <text class="param-desc">微分增益 · 0–20</text>
            <input
              class="param-tag"
              type="digit"
              value="{{kd}}"
              bindinput="onKdInput"
              disabled="{{!connected}}"
            />
          </view>
          <slider
            class="param-slider"
            min="0"
            max="20"
            step="0.1"
            value="{{kd}}"
            activeColor="{{connected ? '#2563eb' : '#9ca3af'}}"
            backgroundColor="#d5dde6"
            block-size="22"
            disabled="{{!connected}}"
            bindchanging="onKdChanging"
            bindchange="onKdChange"
          />
          <view class="quick-row">
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kd" data-delta="-0.5" bindtap="onNudge">−0.5</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kd" data-delta="-0.1" bindtap="onNudge">−0.1</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kd" data-delta="0.1" bindtap="onNudge">+0.1</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kd" data-delta="0.5" bindtap="onNudge">+0.5</button>
          </view>
        </view>
      </view>

      <view class="cascade-hint">
        <text class="cascade-arrow">↑ 外环输出作为内环目标</text>
      </view>

      <view class="card loop-card loop-outer">
        <view class="loop-head">
          <view class="loop-badge">外环</view>
          <view class="loop-meta">
            <text class="loop-title">速度环</text>
            <text class="loop-flow">速度误差 → 目标倾角</text>
          </view>
        </view>

        <view class="param-block accent-kv">
          <view class="param-top">
            <text class="param-title">Kv</text>
            <text class="param-desc">速度增益 · 0–2</text>
            <input
              class="param-tag"
              type="digit"
              value="{{kv}}"
              bindinput="onKvInput"
              disabled="{{!connected}}"
            />
          </view>
          <slider
            class="param-slider"
            min="0"
            max="2"
            step="0.01"
            value="{{kv}}"
            activeColor="{{connected ? '#ea580c' : '#9ca3af'}}"
            backgroundColor="#d5dde6"
            block-size="22"
            disabled="{{!connected}}"
            bindchanging="onKvChanging"
            bindchange="onKvChange"
          />
          <view class="quick-row">
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kv" data-delta="-0.1" bindtap="onNudge">−0.1</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kv" data-delta="-0.01" bindtap="onNudge">−0.01</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kv" data-delta="0.01" bindtap="onNudge">+0.01</button>
            <button class="qbtn" hover-class="none" disabled="{{!connected}}" data-param="kv" data-delta="0.1" bindtap="onNudge">+0.1</button>
          </view>
        </view>
      </view>

      <view class="actions bottom">
        <button class="btn save" hover-class="none" disabled="{{!connected}}" bindtap="onSave">持久化到芯片</button>
      </view>
    </view>
  </view>
</view>
