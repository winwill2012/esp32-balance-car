<view class="page">
  <view class="page-body">
    <ble-status />

    <view class="card dash-card">
      <view class="dash-item">
        <text class="dash-label">左轮速度</text>
        <text class="dash-value">{{leftSpeedText}}</text>
      </view>
      <view class="dash-divider"></view>
      <view class="dash-item">
        <text class="dash-label">当前倾角</text>
        <text class="dash-value">{{angleText}}</text>
      </view>
      <view class="dash-divider"></view>
      <view class="dash-item">
        <text class="dash-label">当前电量</text>
        <text class="dash-value accent">{{batteryText}}</text>
      </view>
      <view class="dash-divider"></view>
      <view class="dash-item">
        <text class="dash-label">右轮速度</text>
        <text class="dash-value">{{rightSpeedText}}</text>
      </view>
    </view>

    <view class="stick-row">
      <view class="stick-col">
        <joystick
          axis="y"
          label="前进 / 后退"
          disabled="{{!connected}}"
          bind:change="onSpeedStick"
        />
      </view>
      <view class="stick-col">
        <joystick
          axis="x"
          label="左转 / 右转"
          disabled="{{!connected}}"
          bind:change="onTurnStick"
        />
      </view>
    </view>

    <view class="card setting-card">
      <view class="setting-top">
        <view class="setting-title-wrap">
          <text class="setting-title">最大速度</text>
          <view
            class="setting-help"
            catchtap="onSettingHelp"
            data-tip="范围 0–25（编码器速度单位），默认 20，过大可能导致翻车"
          >?</view>
        </view>
        <view class="setting-spacer"></view>
        <input
          class="setting-tag"
          type="digit"
          value="{{speedMax}}"
          bindinput="onSpeedMaxInput"
        />
      </view>
      <slider
        min="0"
        max="25"
        step="1"
        value="{{speedMax}}"
        activeColor="#0d3b82"
        backgroundColor="#d7dee8"
        block-size="22"
        bindchanging="onSpeedMaxChanging"
        bindchange="onSpeedMaxChange"
      />
      <view class="setting-quick">
        <button class="sbtn" hover-class="none" data-delta="-1" bindtap="onSpeedMaxNudge">−1</button>
        <button class="sbtn" hover-class="none" bindtap="onSpeedMaxReset">默认</button>
        <button class="sbtn" hover-class="none" data-delta="1" bindtap="onSpeedMaxNudge">+1</button>
      </view>
    </view>

    <view class="card setting-card">
      <view class="setting-top">
        <view class="setting-title-wrap">
          <text class="setting-title">最大转向速度</text>
          <view
            class="setting-help"
            catchtap="onSettingHelp"
            data-tip="范围 0–300 °/s，小程序直接下发目标偏航角速度，固件不再做比例换算；松手或通信超时自动回中"
          >?</view>
        </view>
        <view class="setting-spacer"></view>
        <input
          class="setting-tag"
          type="digit"
          value="{{turnMax}}"
          bindinput="onTurnMaxInput"
        />
        <text class="setting-unit">°/s</text>
      </view>
      <slider
        min="0"
        max="300"
        step="5"
        value="{{turnMax}}"
        activeColor="#0d3b82"
        backgroundColor="#d7dee8"
        block-size="22"
        bindchanging="onTurnMaxChanging"
        bindchange="onTurnMaxChange"
      />
      <view class="setting-quick">
        <button class="sbtn" hover-class="none" data-delta="-10" bindtap="onTurnMaxNudge">−10</button>
        <button class="sbtn" hover-class="none" bindtap="onTurnMaxReset">默认</button>
        <button class="sbtn" hover-class="none" data-delta="10" bindtap="onTurnMaxNudge">+10</button>
      </view>
    </view>
  </view>
</view>
