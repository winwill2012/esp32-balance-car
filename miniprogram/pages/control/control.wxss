.page {
  min-height: 100vh;
  padding: 20rpx 28rpx 48rpx;
  background: #f5f7fa;
}

.card {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border: 2rpx solid #dfe5ec;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.035);
}

.dash-card {
  display: flex;
  align-items: stretch;
  padding: 24rpx 12rpx;
}

.dash-item {
  flex: 1;
  text-align: center;
}

.dash-divider {
  width: 2rpx;
  background: #e2e8f0;
}

.dash-label {
  display: block;
  margin-bottom: 8rpx;
  color: #111827;
  font-size: 22rpx;
}

.dash-value {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.dash-value.accent,
.dash-value.ok {
  color: #0d3b82;
}

.dash-value.off {
  color: #64748b;
  font-size: 26rpx;
}

.setting-card {
  padding-bottom: 18rpx;
}

.setting-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.setting-title-wrap {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 12rpx;
}

.setting-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.setting-help {
  width: 30rpx;
  height: 30rpx;
  color: #0d3b82;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  background: #ffffff;
  border: 2rpx solid #9fb2cb;
  border-radius: 50%;
}

.setting-spacer {
  flex: 1;
  min-width: 0;
}

.setting-tag {
  flex-shrink: 0;
  width: 110rpx;
  height: 48rpx;
  min-height: 48rpx;
  padding: 0 12rpx;
  color: #0d3b82;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
  background: #f1f4f8;
  border: 2rpx solid #e2e8f0;
  border-radius: 8rpx;
}

.setting-unit {
  flex-shrink: 0;
  color: #64748b;
  font-size: 22rpx;
}

.setting-quick {
  display: flex;
  gap: 10rpx;
  margin-top: 8rpx;
}

.sbtn {
  flex: 1;
  height: 60rpx;
  margin: 0;
  padding: 0;
  color: #111827;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 60rpx;
  background: #ffffff;
  border: 2rpx solid #d7dee8;
  border-radius: 8rpx;
  box-shadow: none;
}

.sbtn::after {
  border: none;
}

.stick-row {
  display: flex;
  gap: 20rpx;
  margin: 16rpx 0 20rpx;
  padding: 28rpx 12rpx 14rpx;
  background: #ffffff;
  border: 2rpx solid #dfe5ec;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.035);
}

.stick-col {
  display: flex;
  flex: 1;
  justify-content: center;
}
