.card {
  margin-bottom: 16rpx;
  padding: 18rpx 22rpx;
  background: #ffffff;
  border: 2rpx solid #dfe5ec;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.035);
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.status-row {
  align-items: center;
  gap: 16rpx;
}

.status-left {
  flex: 1;
  min-width: 0;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 12rpx;
  color: #111827;
  font-size: 22rpx;
  font-weight: 600;
  background: transparent;
  border-radius: 8rpx;
}

.badge.on,
.badge.off {
  color: #111827;
  background: transparent;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #1677ff;
  border-radius: 50%;
}

.badge.on .dot {
  background: #16a34a;
}

.device-line {
  display: block;
  margin-top: 8rpx;
  color: #475569;
  font-size: 20rpx;
  word-break: break-all;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0;
  padding: 0;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
  background: #ffffff;
  border: 2rpx solid #1677ff;
  border-radius: 8rpx;
}

.btn::after {
  border: none;
}

.btn.ghost {
  color: #334155;
  border-color: #cbd5e1;
}

.btn.primary[disabled] {
  color: #64748b !important;
  background: #f8fafc !important;
  border-color: #cbd5e1 !important;
  opacity: 1 !important;
}

.btn.primary[loading] {
  color: #1677ff !important;
  background: #ffffff !important;
  border-color: #1677ff !important;
  opacity: 1 !important;
}

.status-btn {
  flex: none !important;
  width: auto;
  min-width: 214rpx;
  padding: 0 24rpx;
}

.scan-glyph {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #1677ff;
  border-radius: 2rpx;
}

.scan-glyph__line {
  position: absolute;
  top: 12rpx;
  left: 5rpx;
  width: 16rpx;
  height: 2rpx;
  background: #1677ff;
}
