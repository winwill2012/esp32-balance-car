.joy {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.joy.is-disabled {
  pointer-events: none;
}

.joy.is-disabled .joy-pad {
  opacity: 0.5;
}

.joy-pad {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  overflow: hidden;
  background: #f8fafc;
  border: 3rpx solid #d7dee8;
  border-radius: 50%;
  box-shadow: inset 0 0 0 8rpx #f1f4f8;
}

.joy.is-active .joy-pad {
  border-color: #1677ff;
}

.joy-ring {
  position: absolute;
  top: 18%;
  right: 18%;
  bottom: 18%;
  left: 18%;
  border: 2rpx dashed #bdc9d8;
  border-radius: 50%;
}

.joy-cross-v,
.joy-cross-h {
  position: absolute;
  background: #d7dee8;
  border-radius: 999rpx;
}

.joy-cross-v {
  top: 12%;
  bottom: 12%;
  left: 50%;
  width: 2rpx;
  margin-left: -1rpx;
}

.joy-cross-h {
  top: 50%;
  right: 12%;
  left: 12%;
  height: 2rpx;
  margin-top: -1rpx;
}

.joy-center-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 10rpx;
  height: 10rpx;
  margin: -5rpx 0 0 -5rpx;
  background: #0d3b82;
  border-radius: 50%;
}

.joy-knob {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 88rpx;
  height: 88rpx;
  margin-top: -44rpx;
  margin-left: -44rpx;
  background: #ffffff;
  border: 4rpx solid #0d3b82;
  border-radius: 50%;
  box-shadow: 0 6rpx 16rpx rgba(13, 59, 130, 0.16);
  transition: box-shadow 0.12s ease;
  will-change: transform;
}

.joy-knob.is-dragging {
  box-shadow: 0 8rpx 20rpx rgba(13, 59, 130, 0.24);
}

.joy-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.joy-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}
